# ============ 数据库（默认本地 SQLite；生产切换华为云 RDS）============
# 华为云 RDS MySQL：
# DATABASE_URL=mysql+pymysql://<账号>:<密码>@<内网地址>:3306/<库名>?charset=utf8mb4
# 华为云 RDS PostgreSQL：
# DATABASE_URL=postgresql+psycopg2://<账号>:<密码>@<内网地址>:5432/<库名>
DATABASE_URL=sqlite:///./campus_delivery.db

# ============ 缓存 / 消息（华为云 DCS Redis；不填则自动降级进程内）============
# REDIS_URL=redis://:<密码>@<内网地址>:6379/0
REDIS_URL=

# ============ 华为云 AK/SK（调用 OCR / 开通 RDS/Redis 等云 API）============
HW_AK=
HW_SK=
HW_REGION=cn-north-4
# 启用 OCR 照片审核（真实识别外卖单号+寝室号）
HW_OCR_ENABLED=

# ============ 业务规则 ============
# 异常上报后无进度超时阈值（秒），默认 600 = 10 分钟，触发自动补偿
ANOMALY_TIMEOUT_SECONDS=600
# 默认补偿金额（元）
COMPENSATION_AMOUNT=5.0

# ============ 华为云子网参数（scripts/provision.py create-subnet 使用）============
# 不填时自动用 VPC 下第一个 + 192.168.1.0/24 + cn-north-4a + 网关 192.168.1.1
# SUBNET_NAME=campus-subnet
# SUBNET_CIDR=192.168.1.0/24
# SUBNET_GATEWAY_IP=192.168.1.1
# SUBNET_AZ=cn-north-4a
# SUBNET_VPC_ID=（不填则取 VPC 列表第一个）

# ============ 华为云 RDS MySQL 开通参数（scripts/provision.py create-rds 使用）============
# 先运行 `python scripts/provision.py probe` 查看可用 flavor / VPC / subnet / AZ，再填入：
# RDS_FLAVOR_REF=rds.mysql.n1.large.4
# RDS_AZ=cn-north-4a
# RDS_VPC_ID=...
# RDS_SUBNET_ID=...
# RDS_SECURITY_GROUP_ID=...
# RDS_NAME=campus-delivery
# RDS_PASSWORD=YourStrongPass!

# ============ 华为云 DCS Redis 开通参数（scripts/provision.py create-dcs 使用）============
# DCS_SPEC_CODE=redis.spec.large.s1
# DCS_AZ=cn-north-4a
# DCS_VPC_ID=...
# DCS_SUBNET_ID=...
# DCS_NAME=campus-delivery-redis
# DCS_PASSWORD=YourStrongPass!
# ============ MiniMax 大模型（3.0 多 Agent 助手）============
# 从 MiniMax 开放平台获取 API Key；base_url / model 以控制台文档为准
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=minimax-m3